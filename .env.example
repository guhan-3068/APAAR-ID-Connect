# ==============================================================================
# APAAR CONNECT AI — Environment Variables Template
# Copy this file to .env for local development or set in Vercel Project Settings.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE KEYS TO VERSION CONTROL.
# ==============================================================================

# JSON Web Token Secret for Authentication (HMAC-SHA256)
# Generate a strong 64-character random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Application Environment
NODE_ENV=production

# (Optional) External Database Connection URL if transitioning from local JSON store
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
