# ==============================================================================
# APAAR CONNECT AI — Environment Variables Template
# Copy this file to .env for local development or set in Vercel Project Settings.
# DO NOT COMMIT REAL SECRETS OR SENSITIVE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE AUTHENTICATION & SECURITY (Required in Production)
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying HMAC-SHA256 JSON Web Tokens (JWT).
# Generate a secure 64-character random string (e.g. `openssl rand -hex 32`):
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Application Environment
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (Optional / Future Cloud Scale)
# ------------------------------------------------------------------------------
# The platform runs with an embedded relational JSON dataset bundled in server/data.
# When migrating to a managed PostgreSQL service (e.g. Neon, Supabase, Vercel Postgres):
# DATABASE_URL=postgresql://dbuser:your_secure_password@your-db-host:5432/apaar_db?sslmode=require

# ------------------------------------------------------------------------------
# 3. AI & OCR INFERENCE SERVICES (Optional / Future Live Providers)
# ------------------------------------------------------------------------------
# The platform currently uses deterministic heuristic rules for data quality & anomaly checks.
# If connecting external LLM or cloud vision models in the future:
# GEMINI_API_KEY=your_gemini_api_key_placeholder
# OPENAI_API_KEY=your_openai_api_key_placeholder

# ------------------------------------------------------------------------------
# 4. CLOUD FILE STORAGE (Optional / For files > 3.5 MB)
# ------------------------------------------------------------------------------
# Vercel Serverless Function payload limit is 4.5 MB. If scaling up to direct cloud uploads:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_placeholder
# AWS_ACCESS_KEY_ID=your_aws_access_key_placeholder
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_placeholder
# AWS_S3_BUCKET_NAME=apaar-student-documents-bucket
# AWS_REGION=ap-south-1
